# Copy this file to `.env` and fill in YOUR values. Never commit `.env`.

# ---- Required ----
# PostgreSQL connection string. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# (URL-encode special characters in USER/PASSWORD, e.g. @ -> %40)
DATABASE_URL=
# Random secret, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Public base URL (used for payment callback URLs), e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=

# ---- Private file storage (S3-compatible, e.g. Liara Object Storage). Empty => uploads report "needs configuration" ----
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true for most S3-compatible providers
STORAGE_FORCE_PATH_STYLE=true
# lifetime of signed download links (30-3600)
STORAGE_SIGNED_URL_TTL_SECONDS=120
# upload size limit in bytes (default 20971520 = 20 MB, max 104857600)
MAX_UPLOAD_BYTES=20971520

# ---- ZarinPal. Empty merchant id => payments report "needs configuration" ----
ZARINPAL_MERCHANT_ID=
# true => use sandbox.zarinpal.com
ZARINPAL_SANDBOX=false

# ---- SMS. No vendor adapter ships yet; leave empty (messages are stored as SKIPPED) ----
SMS_PROVIDER=

# ---- Not used yet (reserved) ----
REDIS_URL=
ERON_API_KEY=
ERON_API_SECRET=
LIVE_PROVIDER_KEY=
